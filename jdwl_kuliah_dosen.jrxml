<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="jdwl_kuliah_dosen" language="groovy" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="8309d09a-385c-4cd6-9c92-ee69cc9479d1">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="nidn" class="java.lang.String"/>
	<parameter name="semester" class="java.lang.String"/>
	<parameter name="thn_akademik" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
    j.kd_jadwal,
    j.kd_matkul,
    m.nm_matkul,
    m.sks,
    j.kelompok,
    j.hari,
    j.jam_mulai,
    j.jam_selesai,
    j.ruang,
    d.nidn,
    d.gelar_depan,
    d.nm_dosen,
    d.gelar_belakang,
    j.semester,
    j.thn_akademik
FROM jadwal j
JOIN dosen d ON j.nidn = d.nidn
JOIN matkul m ON j.kd_matkul = m.kd_matkul
WHERE
    j.nidn = $P{nidn}
    AND j.semester = $P{semester}
    AND j.thn_akademik = CAST($P{thn_akademik} AS UNSIGNED)
ORDER BY FIELD(j.hari, 'Senin', 'Selasa', 'Rabu', 'Kamis', 'Jumat', 'Sabtu'), j.jam_mulai ASC]]>
	</queryString>
