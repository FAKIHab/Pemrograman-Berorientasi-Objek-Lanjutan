<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="khs" language="groovy" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="313e660f-98a1-44b3-8e5a-a16585041d98">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="nim" class="java.lang.String"/>
	<parameter name="semester" class="java.lang.String"/>
	<parameter name="thn_akademik" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT
    mahasiswa.nim,
    mahasiswa.nm_mahasiswa,
    matkul.kd_matkul,
    matkul.nm_matkul,
    matkul.sks,
    ambil.semester,
    ambil.thn_akademik,
    ambil.presensi,
    ambil.tugas,
    ambil.uts,
    ambil.uas
FROM mahasiswa
JOIN ambil ON mahasiswa.nim = ambil.nim
JOIN matkul ON matkul.kd_matkul = ambil.kd_matkul
WHERE mahasiswa.nim = $P{nim}
  AND ambil.semester = $P{semester}
  AND ambil.thn_akademik = $P{thn_akademik}]]>
	</queryString>
	<field name="nim" class="java.lang.String">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="nm_mahasiswa" class="java.lang.String">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="kd_matkul" class="java.lang.String">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="nm_matkul" class="java.lang.String">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="sks" class="java.lang.String">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="semester" class="java.lang.String">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="thn_akademik" class="java.lang.Integer">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="presensi" class="java.lang.Integer">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="tugas" class="java.lang.Integer">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="uts" class="java.lang.Integer">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="uas" class="java.lang.Integer">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<variable name="akhir" class="java.lang.Integer">
		<variableExpression><![CDATA[(int)(0.1 * $F{presensi} + 0.2 * $F{tugas} + 0.3 * $F{uts} + 0.4 * $F{uas})]]></variableExpression>
	</variable>
	<variable name="grade" class="java.lang.String">
		<variableExpression><![CDATA[($F{presensi} < 70) ? "-" : ($V{akhir} >= 0 && $V{akhir} <= 35) ? "E" : ($V{akhir} >= 36 && $V{akhir} <= 50) ? "D" : ($V{akhir} >= 51 && $V{akhir} <= 55) ? "C-" : ($V{akhir} >= 56 && $V{akhir} <= 60) ? "C" : ($V{akhir} >= 61 && $V{akhir} <= 65) ? "C+" : ($V{akhir} >= 66 && $V{akhir} <= 70) ? "B-" : ($V{akhir} >= 71 && $V{akhir} <= 75) ? "B" : ($V{akhir} >= 76 && $V{akhir} <= 80) ? "B+" : ($V{akhir} >= 81 && $V{akhir} <= 90) ? "A-" : "A"]]></variableExpression>
	</variable>
	<variable name="mutu" class="java.lang.Double">
		<variableExpression><![CDATA[$V{grade}.equals("-") ? 0.0 : $V{grade}.equals("E") ? 0.0 : $V{grade}.equals("D") ? 1.0 * Double.parseDouble($F{sks}) : $V{grade}.equals("C-") ? 1.7 * Double.parseDouble($F{sks}) : $V{grade}.equals("C") ? 2.0 * Double.parseDouble($F{sks}) : $V{grade}.equals("C+") ? 2.3 * Double.parseDouble($F{sks}) : $V{grade}.equals("B-") ? 2.7 * Double.parseDouble($F{sks}) : $V{grade}.equals("B") ? 3.0 * Double.parseDouble($F{sks}) : $V{grade}.equals("B+") ? 3.3 * Double.parseDouble($F{sks}) : $V{grade}.equals("A-") ? 3.7 * Double.parseDouble($F{sks}) : $V{grade}.equals("A") ? 4.0 * Double.parseDouble($F{sks}) : 0.0]]></variableExpression>
	</variable>
	<variable name="sks_sum" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[Double.parseDouble($F{sks})]]></variableExpression>
	</variable>
	<variable name="mutu_sum" class="java.lang.Double">
		<variableExpression><![CDATA[$V{mutu}]]></variableExpression>
	</variable>
	<variable name="ips" class="java.lang.String">
		<variableExpression><![CDATA[String.format("%.2f", $V{mutu_sum} / $V{sks_sum})]]></variableExpression>
	</variable>
	<group name="nim">
		<groupExpression><![CDATA[$F{nim}]]></groupExpression>
	</group>
